# Configuration SMTP pour le formulaire de contact (route /api/contact).
# À définir sur l'app Node O2Switch (cPanel → Setup Node.js App → Environment variables),
# ou dans un fichier .env local (non commité).

SMTP_HOST=mail.nicolaon.fr
SMTP_PORT=465
SMTP_USER=no-reply@nicolaon.fr
SMTP_PASS=change-me

# Destinataire des messages et adresse d'expédition (doit appartenir au domaine).
CONTACT_TO=nicolaon.romain@gmail.com
CONTACT_FROM=no-reply@nicolaon.fr

# Analytics Matomo (facultatif). Laisser vide pour désactiver.
NUXT_PUBLIC_MATOMO_URL=https://matomo.nicolaon.fr
NUXT_PUBLIC_MATOMO_SITE_ID=2

# Anti-spam Cloudflare Turnstile (facultatif). Laisser vide pour désactiver le widget.
# Clé publique côté client + secret côté serveur (https://dash.cloudflare.com → Turnstile).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
